<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
    Sin este permiso, el WebView NUNCA puede conceder getUserMedia() a las pantallas de escaneo QR
    (marcacion-kiosco, escaneo-sesion, via @zxing/ngx-scanner) - sin importar lo que responda el usuario en
    cualquier dialogo, porque Android ni siquiera deja pedir en tiempo de ejecucion un permiso que la app no
    declaro aca. Esto hacia que la camara se quedara siempre en el video vacio del navegador (bug real
    reportado por el usuario, 2026-10-05: funcionaba distinto segun probara desde el navegador o desde el .apk
    instalado - el navegador maneja su propio permiso de sitio, el .apk dependia de este permiso que faltaba).
    android.hardware.camera required=false: el .apk se distribuye por descarga directa, no por Play Store, pero
    sigue siendo buena practica no excluir dispositivos sin camara de poder instalarlo igual.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
